# Copiar a .env y ajustar (nunca versionar .env). Cargar con: set -a; source .env; set +a
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fastorder
DB_USERNAME=fastorder
DB_PASSWORD=cambiar-esto
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
DELIVERY_SERVICE_PORT=8084
